def estimar_distancia_punto(punto1, punto2, f, B):
    # Calcular a disparidade (diferenza na coordenada x)
    disparidade = punto1[0] - punto2[0]

    # Calcular a profundidade usando a fórmula estéreo
    Z = (f * B) / disparidade
    
    return Z

